{
  "development": {
    "app": {
      "host": "127.0.0.1",
      "port": 5000,
      "debug": true,
      "testing": false
    },
    "logging": {
      "level": "DEBUG",
      "log_dir": "logs",
      "app_log_file": "app.log",
      "trace_log_file": "trace.log",
      "max_bytes": 1048576,
      "backup_count": 5
    },
    "security": {
      "secret_key": "dev-secret-key-change-in-production",
      "session_cookie_secure": false,
      "session_cookie_httponly": true,
      "session_cookie_samesite": "Lax"
    },
    "session": {
      "permanent_session_lifetime_hours": 1
    }
  },
  "testing": {
    "app": {
      "host": "127.0.0.1",
      "port": 5000,
      "debug": true,
      "testing": true
    },
    "logging": {
      "level": "DEBUG",
      "log_dir": "logs",
      "app_log_file": "app.log",
      "trace_log_file": "trace.log",
      "max_bytes": 1048576,
      "backup_count": 5
    },
    "security": {
      "secret_key": "testing-secret-key",
      "session_cookie_secure": false,
      "session_cookie_httponly": true,
      "session_cookie_samesite": "Lax"
    },
    "session": {
      "permanent_session_lifetime_hours": 1
    }
  },
  "production": {
    "app": {
      "host": "0.0.0.0",
      "port": 5000,
      "debug": false,
      "testing": false
    },
    "logging": {
      "level": "INFO",
      "log_dir": "logs",
      "app_log_file": "app.log",
      "trace_log_file": "trace.log",
      "max_bytes": 10485760,
      "backup_count": 10
    },
    "security": {
      "secret_key": null,
      "session_cookie_secure": true,
      "session_cookie_httponly": true,
      "session_cookie_samesite": "Strict"
    },
    "session": {
      "permanent_session_lifetime_hours": 1
    }
  }
}
